# Copy this file to .env.local and fill in your values.

# Postgres — use the pooled connection URL from Supabase/Neon for DATABASE_URL
# and the direct (non-pooled) URL for DIRECT_URL.
# Prisma migrations need a direct connection; queries use the pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"

# Upstash Redis (optional — idempotency degrades gracefully if unset)
UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR-TOKEN"

# Vercel Cron secret — set this in your Vercel project env vars and in vercel.json
# Leave unset in dev to allow unauthenticated cron calls.
CRON_SECRET="a-random-secret-string"
